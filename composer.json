{
    "name": "aghfatehi/laravel-zatca",
    "description": "Laravel package for ZATCA (Fatoora) Phase 1 & Phase 2 integration - Saudi Arabia e-invoicing compliance",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": ["zatca", "fatoora", "saudi-arabia", "e-invoicing", "laravel", "zakat", "tax", "phase1", "phase2"],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "suggest": {
        "endroid/qr-code": "Required for rendering QR code as images (PNG/SVG). Install with: composer require endroid/qr-code",
        "simplesoftwareio/simple-qrcode": "Alternative QR code library using BaconQrCode"
    },
    "autoload": {
        "psr-4": {
            "Aghfatehi\\Zatca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aghfatehi\\Zatca\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aghfatehi\\Zatca\\ZatcaServiceProvider"
            ],
            "aliases": {
                "Zatca": "Aghfatehi\\Zatca\\Facades\\Zatca"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "AL-AGHBARI Fatehi",
            "email": "aghfatehi@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/aghfatehi/laravel-zatca/issues",
        "source": "https://github.com/aghfatehi/laravel-zatca"
    }
}
