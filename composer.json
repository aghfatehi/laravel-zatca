{
    "name": "aghfatehi/laravel-zatca",
    "description": "Laravel ZATCA (Fatoora) package for Saudi e-invoicing Phase 1 & Phase 2 compliance. دمج الفاتورة الإلكترونية السعودية مع لارافيل - المرحلة الأولى والثانية لهيئة الزكاة والضريبة والجمارك",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "zatca", "fatoora", "فاتورة", "saudi-arabia", "السعودية",
        "e-invoicing", "الفاتورة-الإلكترونية",
        "laravel", "لارافيل",
        "zakat", "tax", "الزكاة", "الضريبة",
        "هيئة-الزكاة-والدخل", "هيئة-الزكاة-والضريبة-والجمارك",
        "phase1", "المرحلة-الأولى",
        "phase2", "المرحلة-الثانية",
        "integration", "دمج",
        "QR", "TLV", "التكامل", "السعودية", "riyadh", "المملكة"
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "suggest": {
        "simplesoftwareio/simple-qrcode": "REQUIRED for ZATCA-compatible QR codes. Install with: composer require simplesoftwareio/simple-qrcode",
        "endroid/qr-code": "Alternative QR library (also ZATCA-compatible). Install with: composer require endroid/qr-code"
    },
    "autoload": {
        "psr-4": {
            "Aghfatehi\\Zatca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aghfatehi\\Zatca\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "ignore-id": [
                    "PKSA-mdq4-51ck-6kdq",
                    "PKSA-8qx3-n5y5-vvnd",
                    "PKSA-w7xr-vk7n-rstm"
                ]
            }
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aghfatehi\\Zatca\\ZatcaServiceProvider"
            ],
            "aliases": {
                "Zatca": "Aghfatehi\\Zatca\\Facades\\Zatca"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "AL-AGHBARI Fatehi",
            "email": "aghfatehi@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/aghfatehi/laravel-zatca/issues",
        "source": "https://github.com/aghfatehi/laravel-zatca"
    }
}
